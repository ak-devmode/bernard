# OpenClaw environment variables
# Copy to ~/.openclaw/.env on the server and fill in real values
#
# Referenced by openclaw.json via ${VAR} interpolation

# API keys
ELEVENLABS_API_KEY=
BRAVE_API_KEY=
OPENAI_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=

# Gateway
GATEWAY_AUTH_TOKEN=

# OpenRouter (for Bernard's LLM calls)
OPENROUTER_API_KEY=

# Anthropic (for Claude Code / acpx dispatch)
ANTHROPIC_API_KEY=
